# ---------------------------------------------------------------- app + db
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Homebrew Postgres. Swap for the Supabase pooler string when the
# Supabase project exists — the migrations apply unchanged to either.
DATABASE_URL=postgresql://benhuang@localhost:5432/wallet_loyalty

# Signs the QR code on every card. Min 32 chars. Changing it invalidates every
# card already in a customer's wallet, so treat it as permanent.
QR_TOKEN_SECRET=

# Signs the staff scanner cookie. Min 32 chars. Safe to rotate (signs everyone out).
SESSION_SECRET=

# Guards POST /api/jobs/drain so only the cron can run the queue.
CRON_SECRET=

# ------------------------------------------------------------------- email
# Password resets and signup confirmations, over SMTP from the tryrepio.com
# mailbox. No third-party provider: the mailbox is already paid for.
#
# Leave SMTP_HOST BLANK to degrade gracefully — nothing is sent, and the
# message (including the reset link) goes to the server log instead. That is
# what makes the flow testable locally with no credentials.
#
# Two production paths, both keyed on SMTP_HOST:
#   A) AUTHENTICATED MAILBOX — works from anywhere.
#        SMTP_HOST=smtp.titan.email   SMTP_PORT=587
#        SMTP_USER=hello@tryrepio.com SMTP_PASS=<mailbox password>
#   B) AUTH-LESS RELAY — authorises by source IP, so only from the GoDaddy box.
#        SMTP_HOST=relay-hosting.secureserver.net  SMTP_PORT=25
#        (leave SMTP_USER and SMTP_PASS blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From header. no-reply@ is an alias on hello@tryrepio.com, so a reply
# still reaches a person.
MAIL_FROM=Repio <no-reply@tryrepio.com>
# Set to 1 in PRODUCTION ONLY. Refuses to start rather than silently swallow
# every reset link into the log when SMTP_HOST is missing or misspelt.
SMTP_REQUIRED=

# ------------------------------------------------------- not configured yet
# Supabase (owner auth + logo storage) — Phase 4
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Wallet — Phase 1. Needs the $99/yr Developer Program.
# REMINDER: the pass certificate expires every year. When it lapses, no new
# passes can be signed and every existing card stops updating, silently.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_BASE64=

# Google Wallet — Phase 2. A new issuer account starts in DEMO mode (only
# allowlisted Google accounts can save a pass) until a publishing review clears.
# The 18-digit number from the Google Pay & Wallet console.
GOOGLE_WALLET_ISSUER_ID=
# base64 -i service-account.json | tr -d "\n"
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Stripe — Phase 5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=

# Twilio Verify, card recovery only — Phase 5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
