# ---------------------------------------------------------------- app + db
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Homebrew Postgres. Swap for the Supabase pooler string when the
# Supabase project exists — the migrations apply unchanged to either.
DATABASE_URL=postgresql://benhuang@localhost:5432/wallet_loyalty

# Signs the QR code on every card. Min 32 chars. Changing it invalidates every
# card already in a customer's wallet, so treat it as permanent.
QR_TOKEN_SECRET=

# Signs the staff scanner cookie. Min 32 chars. Safe to rotate (signs everyone out).
SESSION_SECRET=

# Guards POST /api/jobs/drain so only the cron can run the queue.
CRON_SECRET=

# ------------------------------------------------------- not configured yet
# Supabase (owner auth + logo storage) — Phase 4
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Wallet — Phase 1. Needs the $99/yr Developer Program.
# REMINDER: the pass certificate expires every year. When it lapses, no new
# passes can be signed and every existing card stops updating, silently.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_BASE64=

# Google Wallet — Phase 2. A new issuer account starts in DEMO mode (only
# allowlisted Google accounts can save a pass) until a publishing review clears.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Stripe — Phase 5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=

# Twilio Verify, card recovery only — Phase 5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
